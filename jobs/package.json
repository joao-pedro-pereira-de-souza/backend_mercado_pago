  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/index.ts",
    "build": "npx babel src --extensions \".js,.ts\" --out-dir dist --copy-files --no-copy-ignored",
    "test": "clear && NODE_ENV=test NODE_OPTIONS='--no-deprecation --loader ts-node/esm' jest --clearCache && node_modules/.bin/jest --injectGlobals false --runInBand --no-cache --verbose tests/",
    "test:debug": "NODE_ENV=test NODE_OPTIONS='--no-deprecation --loader ts-node/esm' jest --clearCache && node --watch node_modules/.bin/jest --watchAll --injectGlobals false --runInBand --no-cache --verbose tests/",
    "start": "node dist/index.js"
  },
